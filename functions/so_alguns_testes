bool caca_palavra(char** matriz, int n, int m, char* palavra)
{
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            int k = 0;

            while (palavra[k] != '\0' &&
                   j + k < m &&
                   matriz[i][j + k] == palavra[k])
